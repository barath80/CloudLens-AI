# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- PostgreSQL (docker compose db service) ---
POSTGRES_USER=cloudlens
POSTGRES_PASSWORD=
POSTGRES_DB=cloudlens
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Used when running the backend on the host (outside Docker). Compose builds its own URL for the container.
DATABASE_URL=postgresql+psycopg://cloudlens:<POSTGRES_PASSWORD>@127.0.0.1:5432/cloudlens
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
# Backend URL as seen from the BROWSER
VITE_API_BASE_URL=http://localhost:8000/api/v1
